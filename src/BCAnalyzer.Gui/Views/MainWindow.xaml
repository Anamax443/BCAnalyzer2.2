<Window x:Class="BCAnalyzer.Gui.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BC SQL Performance Analyzer — AXIMA" Height="780" Width="950"
        WindowStartupLocation="CenterScreen"
        Background="#f4f5f7">

    <Window.Resources>
        <Style x:Key="HeaderLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#5a5d6b"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#e2e4e9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="24,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="BC SQL Performance Analyzer" FontSize="22" FontWeight="Bold" FontFamily="Segoe UI" Foreground="#1a1a2e"/>
            <TextBlock Text="READ-ONLY diagnostika — žádné modifikace dat" FontSize="12" Foreground="#8b8fa3" FontFamily="Segoe UI"/>
        </StackPanel>

        <!-- Connection Parameters -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,8"
                BorderBrush="#e2e4e9" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Column="0" Grid.Row="0" Text="NAV Server (Event Log)" Style="{StaticResource HeaderLabel}"/>
                <TextBox x:Name="TxtNavServer" Grid.Column="0" Grid.Row="1" Text="B-S-W-NAV-01" Style="{StaticResource InputBox}"/>

                <TextBlock Grid.Column="2" Grid.Row="0" Text="SQL Server" Style="{StaticResource HeaderLabel}"/>
                <TextBox x:Name="TxtSqlServer" Grid.Column="2" Grid.Row="1" Text="B-S-W-SQL-01" Style="{StaticResource InputBox}"/>

                <TextBlock Grid.Column="4" Grid.Row="0" Text="Databáze" Style="{StaticResource HeaderLabel}"/>
                <TextBox x:Name="TxtDatabase" Grid.Column="4" Grid.Row="1" Text="NAV-LIVE" Style="{StaticResource InputBox}"/>

                <StackPanel Grid.Column="6" Grid.Row="0" Grid.RowSpan="2" VerticalAlignment="Bottom">
                    <TextBlock Text="Lookback" Style="{StaticResource HeaderLabel}" HorizontalAlignment="Center"/>
                    <TextBox x:Name="TxtHours" Text="24" Width="50" TextAlignment="Center" Style="{StaticResource InputBox}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Credentials -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,8"
                BorderBrush="#e2e4e9" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Integrated Security Toggle -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <CheckBox x:Name="ChkIntegrated" Content="Použít aktuální Windows účet (Integrated Security)"
                              FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="#1a1a2e"
                              IsChecked="True" VerticalContentAlignment="Center"
                              Checked="ChkIntegrated_Changed" Unchecked="ChkIntegrated_Changed"/>
                    <TextBlock x:Name="TxtCurrentUser" Margin="16,0,0,0" FontSize="12" Foreground="#8b8fa3"
                               FontFamily="Consolas" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Explicit Credentials -->
                <Grid x:Name="PnlCredentials" Grid.Row="1" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Column="0" Grid.Row="0" Style="{StaticResource HeaderLabel}">
                        <Run Text="Uživatel"/>
                        <Run Text="  (DOMAIN\user)" Foreground="#8b8fa3" FontWeight="Normal" FontSize="11"/>
                    </TextBlock>
                    <TextBox x:Name="TxtUsername" Grid.Column="0" Grid.Row="1" Style="{StaticResource InputBox}"
                             Text="" ToolTip="Formát: DOMAIN\username nebo username@domain"/>

                    <TextBlock Grid.Column="2" Grid.Row="0" Text="Heslo" Style="{StaticResource HeaderLabel}"/>
                    <PasswordBox x:Name="TxtPassword" Grid.Column="2" Grid.Row="1"
                                 FontFamily="Consolas" FontSize="13" Padding="8,6"
                                 BorderBrush="#e2e4e9" BorderThickness="1" Background="White"/>

                    <StackPanel Grid.Column="4" Grid.Row="0" Grid.RowSpan="2" VerticalAlignment="Bottom" Margin="0,0,0,2">
                        <Button x:Name="BtnTestConn" Content="🔗 Test" Click="BtnTestConn_Click"
                                FontFamily="Segoe UI" FontSize="12" Padding="12,8" Cursor="Hand"
                                Background="#f0f0f0" BorderBrush="#e2e4e9" BorderThickness="1"
                                ToolTip="Otestovat připojení k Event Logu a SQL Serveru"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,8">
            <Button x:Name="BtnRun" Content="▶  Spustit analýzu" Click="BtnRun_Click"
                    Style="{StaticResource ActionBtn}" Background="#3b82f6" Foreground="White"/>
            <Button x:Name="BtnCancel" Content="■  Zrušit" Click="BtnCancel_Click" Margin="12,0,0,0"
                    Style="{StaticResource ActionBtn}" Background="#ef4444" Foreground="White" IsEnabled="False"/>
            <Button x:Name="BtnOpenReport" Content="📄 Otevřít report" Click="BtnOpenReport_Click" Margin="12,0,0,0"
                    Style="{StaticResource ActionBtn}" Background="#22c55e" Foreground="White" IsEnabled="False"/>
        </StackPanel>

        <!-- Log Output -->
        <Border Grid.Row="4" Background="White" CornerRadius="8" Padding="4" BorderBrush="#e2e4e9" BorderThickness="1">
            <ListBox x:Name="LstLog" FontFamily="Consolas" FontSize="12" BorderThickness="0"
                     Background="White" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
        </Border>

        <!-- Status Bar -->
        <Grid Grid.Row="5" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ProgressBar x:Name="Prog" Height="20" Grid.Column="0" Minimum="0" Maximum="100"
                         Foreground="#3b82f6" Background="#e2e4e9"/>
            <TextBlock x:Name="TxtStatus" Grid.Column="1" Margin="12,0,0,0"
                       VerticalAlignment="Center" FontSize="12" Foreground="#5a5d6b" FontFamily="Segoe UI"/>
        </Grid>
    </Grid>
</Window>
